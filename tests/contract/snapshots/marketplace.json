{
 "create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "ProposalDraftInput": {
     "properties": {
      "bid_amount": {
       "description": "Bid in USD",
       "exclusiveMinimum": 0,
       "maximum": 100000,
       "title": "Bid Amount",
       "type": "number"
      },
      "cover_letter": {
       "description": "Approved proposal text",
       "maxLength": 5000,
       "minLength": 50,
       "title": "Cover Letter",
       "type": "string"
      },
      "dry_run": {
       "default": false,
       "description": "Return what would be sent and its cost, without sending",
       "title": "Dry Run",
       "type": "boolean"
      },
      "freelancer_id": {
       "maxLength": 100,
       "minLength": 1,
       "title": "Freelancer Id",
       "type": "string"
      },
      "idempotency_key": {
       "description": "Stable key; retries never duplicate",
       "maxLength": 200,
       "minLength": 8,
       "title": "Idempotency Key",
       "type": "string"
      },
      "job_id": {
       "maxLength": 100,
       "minLength": 1,
       "title": "Job Id",
       "type": "string"
      },
      "meta": {
       "additionalProperties": true,
       "title": "Meta",
       "type": "object"
      },
      "screening_answers": {
       "items": {
        "type": "string"
       },
       "maxItems": 10,
       "title": "Screening Answers",
       "type": "array"
      }
     },
     "required": [
      "freelancer_id",
      "job_id",
      "cover_letter",
      "bid_amount",
      "idempotency_key"
     ],
     "title": "ProposalDraftInput",
     "type": "object"
    }
   },
   "properties": {
    "input": {
     "$ref": "#/$defs/ProposalDraftInput"
    }
   },
   "required": [
    "input"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "connects_balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Balance After"
    },
    "connects_cost": {
     "default": 0,
     "title": "Connects Cost",
     "type": "integer"
    },
    "detail": {
     "additionalProperties": true,
     "title": "Detail",
     "type": "object"
    },
    "id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Id"
    },
    "marketplace": {
     "title": "Marketplace",
     "type": "string"
    },
    "status": {
     "enum": [
      "dry_run",
      "created",
      "submitted",
      "sent",
      "replayed",
      "error"
     ],
     "title": "Status",
     "type": "string"
    },
    "would_send": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Would Send"
    }
   },
   "required": [
    "status",
    "marketplace"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
