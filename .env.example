# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Secret for session signing and OAuth-token encryption (any long random string)
APP_SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=postgresql://postgres@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# Model profile: open (open-weight via Groq) | offline (deterministic heuristics, no key needed)
MODEL_PROFILE=open
GROQ_API_KEY=

# Marketplace
MARKETPLACE_ADAPTER=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=gigsim-dev-token
# Bearer token the agent uses to call our own MCP servers
MCP_BEARER_TOKEN=mcp-dev-token

# Live mode (official Upwork MCP server, OAuth 2.1)
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/api/onboarding/upwork/callback

# Third-party GitHub MCP server (repo ingestion), read-only token
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=

# Tracing (optional): LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid

# Reviewer account seeded on startup
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=change-me
